@startuml ReadTrack System Architecture
top to bottom direction
title ReadTrack — System Architecture Diagram

skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 50

skinparam component {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  FontSize 12
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #85929E
  FontSize 12
  FontStyle bold
}
skinparam database {
  BackgroundColor #FEF9E7
  BorderColor #D4AC0D
  FontSize 12
}
skinparam cloud {
  BackgroundColor #F4F6F6
  BorderColor #717D7E
  FontSize 12
}
skinparam node {
  BackgroundColor #EAFAF1
  BorderColor #1E8449
  FontSize 12
  FontStyle bold
}

' =============================================
' LAYER 1: User
' =============================================
actor "Teacher" as teacher

' =============================================
' LAYER 2: Frontend — React 19 + TypeScript
' =============================================
node "Frontend  (React 19 · TypeScript · Vite 6)" as frontend {

  package "Pages & Components" as pages {
    [App.tsx\n(Router & Layout)] as app
    [Dashboard.tsx\n(Grade 7 Analytics)] as dashboard
    [StudentGrading/\n(Essay Grading)] as grading
    [MaterialLibrary.tsx\n(Upload · Language Filter · Browse)] as matlib
    [MaterialChecker.tsx\n(G7 Suitability Panel)] as matchecker
    [GrammarChecker.tsx] as grammarui
    [Analyzer.tsx] as analyzer
  }

  package "Frontend Services" as services {
    [pythonService.ts\n(Backend API · detectLanguageAPI)] as pyservice
    [grammarService.ts\n(Grammar API)] as gramservice
    [supabaseService.ts\n(Auth & Database)] as supaservice
  }

  package "State & Storage" as state {
    [React State\n(Per-component)] as reactstate
    [localStorage\n(Analysis history · Cached materials)] as localstorage
  }
}

' =============================================
' LAYER 3: Backend — FastAPI + Python
' =============================================
node "Backend  (FastAPI · Python · Uvicorn)" as backend {

  package "API Endpoints" as endpoints {
    [main.py\n/analyze/student\n/analyze/complexity\n/analyze/rubric\n/ocr/extract\n/reference/ingest] as mainapi
    [grammar_service.py\n/api/grammar/check\n/api/spelling/check] as grammarapi
    [tagalog_service.py\n/api/tagalog/analyze] as tagalogapi
  }

  package "NLP Processing" as nlp {
    [preprocessing.py\n(24-dim feature extraction)] as preprocess
    [spaCy  en_core_web_sm\n(English tokenisation, POS)] as spacy
    [calamanCy  tl_calamancy_md\n(Filipino POS, NER, dependency)] as calamancy
    [LanguageTool\n(Grammar rules engine)] as langtool
    [SymSpellPy\n(Dictionary spell check)] as symspell
    [langdetect\n(Language identification)] as langdetect
  }

  package "Machine Learning (SVM)" as ml {
    [svm_models.py\n(Proficiency & Complexity)] as svmmodels
    [proficiency_model.pkl\n→ Nagsisimula / Papaunlad / Mahusay] as profmodel
    [complexity_model.pkl\n→ Literal / Inferential / Evaluative] as compmodel
    [scaler.pkl files\n(RobustScaler)] as scalers
  }

  package "Text Extraction" as extraction {
    [ocr.py\n(Gemini Vision OCR)] as ocr
    [pypdf\n(PDF text extraction)] as pypdf
  }

  package "Training Pipeline" as training {
    [train_proficiency.py] as trainprof
    [train_complexity.py] as traincomp
    [train_utils.py\n(GridSearchCV)] as trainutils
  }
}

' =============================================
' LAYER 4: External Services
' =============================================
cloud "Google Gemini 2.5 Flash\n(OCR · Rubric Feedback · Grammar AI\n Language Detection)" as gemini

database "Supabase" as supabase {
  [Auth (JWT + RLS)] as auth
  [PostgreSQL\n(teacher_evaluations\nmaterial_uploads\nstudent_grading_uploads)] as postgres
}

database "Training Data\n(Labeled essay & material corpora)" as traindata

' =============================================
' CONNECTIONS: User → Frontend
' =============================================
teacher -down--> app

' =============================================
' CONNECTIONS: App → Pages
' =============================================
app -down-> dashboard
app -down-> grading
app -down-> matlib
app -down-> matchecker
app -down-> grammarui


' =============================================
' CONNECTIONS: Pages → Services
' =============================================
grading -down-> pyservice
grading -down-> analyzer
matlib -down-> pyservice
matchecker -down-> pyservice
grammarui -down-> gramservice
analyzer -down-> pyservice
dashboard -down-> supaservice

' =============================================
' CONNECTIONS: Frontend Services → Backend
' =============================================
pyservice -down-> mainapi : HTTP REST
gramservice -down-> grammarapi : HTTP REST
pyservice -down-> tagalogapi : HTTP REST

' =============================================
' CONNECTIONS: Frontend Services → External
' =============================================
supaservice -down-> auth : HTTPS

' =============================================
' CONNECTIONS: Backend internal
' =============================================
mainapi -down-> preprocess
mainapi -down-> svmmodels
mainapi -down-> ocr
mainapi -down-> pypdf
mainapi -down-> langdetect

svmmodels -down-> profmodel
svmmodels -down-> compmodel
svmmodels -down-> scalers

preprocess -down-> spacy
preprocess -down-> calamancy

grammarapi -down-> langtool
grammarapi -down-> symspell
tagalogapi -down-> calamancy

' =============================================
' CONNECTIONS: Backend → External
' =============================================
ocr -down-> gemini : Gemini Vision
grammarapi -down-> gemini : AI corrections
mainapi -down-> postgres : results + training data

' =============================================
' CONNECTIONS: Training
' =============================================
trainprof -down-> traindata
traincomp -down-> traindata
trainprof -right-> trainutils
traincomp -right-> trainutils
trainprof -left-> profmodel : generates
traincomp -left-> compmodel : generates

' =============================================
' CONNECTIONS: Supabase internal
' =============================================
auth -down-> postgres

@enduml
