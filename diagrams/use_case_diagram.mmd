graph LR
    Teacher(["Teacher"])

    subgraph System["ReadTrack System"]

        subgraph Auth["Authentication"]
            UC_LOGIN["Login"]
            UC_LOGOUT["Logout"]
        end

        subgraph Grading["Student Grading"]
            UC_UPLOAD["Upload Student Essay<br/>Text / Image / PDF"]
            UC_PROFICIENCY["Classify Writing Level<br/>Nagsisimula / Papaunlad / Mahusay"]
            UC_COMPLEXITY["Classify Text Complexity<br/>Literal / Inferential / Evaluative"]
            UC_FEEDBACK["Generate AI Rubric Feedback"]
            UC_SAVE["View & Save Grading Results"]
        end

        subgraph MatLib["Material Library"]
            UC_MATERIAL["Upload Reading Material<br/>Text / Image / PDF"]
            UC_LANG_DETECT["Auto-Detect Material Language<br/>English / Filipino"]
            UC_MAT_CLASSIFY["Auto-Classify Material Complexity<br/>+ Teacher Confirmation Modal"]
            UC_BROWSE["Browse & Filter Materials<br/>by Language and Complexity"]
        end

        subgraph GrammarSpelling["Grammar & Spelling"]
            UC_GRAMMAR["Check Grammar<br/>LanguageTool rules engine"]
            UC_SPELLING["Check Spelling<br/>SymSpellPy dictionary"]
            UC_AI_GRAMMAR["AI-Enhanced Corrections<br/>Gemini context-aware"]
        end

        subgraph TextIngest["Text Ingestion"]
            UC_OCR["Extract Text from Image<br/>Gemini Vision OCR"]
            UC_PDF["Extract Text from PDF<br/>pypdf"]
            UC_LANG["Detect Language<br/>English / Filipino"]
        end

        subgraph DashAnalytics["Dashboard & Analytics"]
            UC_COMPLEXITY_CHART["View Grade 7 Complexity<br/>Distribution Chart"]
            UC_PROFICIENCY_CHART["View Student Proficiency<br/>Distribution Chart"]
            UC_COUNTS["View Essay & Material Counts"]
            UC_QUICKNAV["Navigate to Tools<br/>Quick Actions"]
        end

        subgraph ModelMgmt["Model Management"]
            UC_EVAL["View ML Model Performance<br/>Accuracy · F1 Score"]
            UC_RETRAIN["Trigger Model Retraining<br/>from teacher-rated samples"]
        end

    end

    %% Teacher connections
    Teacher --- UC_LOGIN
    Teacher --- UC_LOGOUT
    Teacher --- UC_UPLOAD
    Teacher --- UC_MATERIAL
    Teacher --- UC_BROWSE
    Teacher --- UC_GRAMMAR
    Teacher --- UC_COMPLEXITY_CHART
    Teacher --- UC_PROFICIENCY_CHART
    Teacher --- UC_COUNTS
    Teacher --- UC_QUICKNAV
    Teacher --- UC_EVAL
    Teacher --- UC_RETRAIN

    %% Student Grading includes / extends
    UC_OCR -.->|extend| UC_UPLOAD
    UC_PDF -.->|extend| UC_UPLOAD
    UC_UPLOAD -.->|include| UC_LANG
    UC_UPLOAD -.->|include| UC_PROFICIENCY
    UC_UPLOAD -.->|include| UC_COMPLEXITY
    UC_UPLOAD -.->|include| UC_FEEDBACK
    UC_PROFICIENCY -.->|include| UC_SAVE

    %% Material Library includes
    UC_MATERIAL -.->|include| UC_LANG_DETECT
    UC_MATERIAL -.->|include| UC_MAT_CLASSIFY

    %% Grammar includes
    UC_GRAMMAR -.->|include| UC_SPELLING
    UC_AI_GRAMMAR -.->|extend| UC_GRAMMAR
