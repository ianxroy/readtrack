@startuml ReadTrack Activity Diagram
title ReadTrack — Activity Diagram

skinparam ActivityBackgroundColor #F8FAFF
skinparam ActivityBorderColor #4A90D9
skinparam ActivityFontSize 13
skinparam ArrowColor #4A90D9
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825
skinparam swimlane {
  BorderColor #B0BEC5
  TitleFontSize 12
  TitleFontStyle bold
}

|Teacher|
start

:User opens ReadTrack;

|Frontend|
if (Authenticated?) then (no)
  :Display Login Page;
  |Teacher|
  :Enter Credentials;
  |Supabase|
  :Authenticate via Supabase Auth;
  if (Valid Credentials?) then (no)
    |Frontend|
    :Show Error Message;
    stop
  else (yes)
  endif
else (yes)
endif

|Frontend|
:Display Dashboard\n(Grade 7 Reading Complexity & Proficiency Tracker);

|Teacher|
switch (Select Action)

case (Student Grading)
  :Navigate to Student Grading;

  switch (Input Method)
  case (Type / Paste)
    :Enter essay text directly;
  case (Upload Image)
    :Upload image file;
    |Gemini AI|
    :Extract text via Gemini Vision OCR;
    |Teacher|
  case (Upload PDF)
    :Upload PDF file;
    |Backend|
    :Extract text via pypdf;
    |Teacher|
  endswitch

  :Submit essay for analysis;

  |Backend|
  fork
    :Detect Language\n(English or Filipino);
  fork again
    :Extract 24-Dimensional\nLinguistic Feature Vector\n(vocabulary, syntax, readability,\nsentence structure, CEFR groups);
  fork again
    :Check Grammar & Spelling\n(LanguageTool + SymSpellPy);
  end fork

  if (Language is Filipino?) then (yes)
    :Process with calamanCy\n(POS tagging, NER, dependency parsing);
  else (no)
    :Process with spaCy en_core_web_sm;
  endif

  fork
    :Classify Student Writing Level (SVM)\n[Nagsisimula | Papaunlad | Mahusay];
  fork again
    :Classify Text Complexity (SVM)\n[Literal | Inferential | Evaluative];
  fork again
    :Compute Readability Scores\n(Flesch-Kincaid, Gunning Fog);
  end fork

  |Gemini AI|
  :Generate AI Rubric Feedback\n(Gemini 2.5 Flash);

  |Frontend|
  :Display Results\n(writing level, complexity, grammar issues,\nreadability scores, AI feedback);

  |Teacher|
  if (Save analysis?) then (yes)
    |Supabase|
    :Save to Supabase\n(student_grading_uploads);
    |Frontend|
    :Dashboard updated with new data;
  else (no)
  endif

case (Material Library)
  |Teacher|
  :Navigate to Material Library;

  switch (Action)
  case (Upload Material)
    :Upload text, image, or PDF;
    |Backend|
    :Extract text content;

    fork
      :Detect Language\n(detectLanguageAPI → eng or fil);
    fork again
      :Extract linguistic features;
      :Classify complexity via SVM\n(Literal / Inferential / Evaluative);
    end fork

    |Supabase|
    :Save material with language tag\n(material_uploads in Supabase);

  case (Browse & Filter)
    |Supabase|
    :Load materials from Supabase;
    |Backend|
    :Detect language for all materials\n(parallel Promise.all);
    |Frontend|
    :Filter by Language\n(All | English | Filipino);
    :Filter by Complexity Level;
    :View material card and detail;
  endswitch

case (Material Checker — G7 Suitability)
  |Teacher|
  :Navigate to Material Checker;
  :Paste reading material or upload file;

  |Backend|
  :Send to POST /analyze/complexity;

  :SVM classifies complexity level\n(Literal | Inferential | Evaluative);

  note right
    Verdict is determined by the SVM
    complexity model alone — anchored
    to DepEd Grade 7 MELCs standards.
    Flesch-Kincaid is display-only.
  end note

  if (Complexity Level == Literal?) then (yes)
    :Verdict: Ready for Grade 7;
  elseif (Complexity Level == Inferential?) then (yes)
    :Verdict: Use with Teacher Support;
  else (Evaluative)
    :Verdict: Above Grade 7 Level;
  endif

  :Derive Phil-IRI Reading Level\n(Flesch-Kincaid score → Independent / Instructional / Frustration)\n[Display only — does not affect verdict];

  if (CEFR word group data available?) then (yes)
    :Display vocabulary breakdown\n(% Basic · % Intermediate · % Advanced);
  else (no)
  endif

  |Frontend|
  :Display G7 Suitability Panel\n(verdict badge, Phil-IRI level, explanation);

case (Grammar Checker)
  |Teacher|
  :Navigate to Grammar Checker;
  :Enter or paste text;

  |Backend|
  fork
    :LanguageTool\n(grammar & punctuation rules);
  fork again
    :SymSpellPy\n(fast dictionary spell check);
  end fork

  |Gemini AI|
  :Enhance with Gemini AI\n(context-aware corrections & explanations);

  |Frontend|
  :Display issues with inline highlights;
  :Show suggestions and replacements;

case (Dashboard & Analytics)
  |Frontend|
  :View Grade 7 Complexity Distribution;
  :View Student Proficiency Distribution;
  :View essay and material metrics;
  :Access quick-action navigation;

endswitch

stop

@enduml
