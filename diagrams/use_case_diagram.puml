@startuml ReadTrack Use Case Diagram
left to right direction
title ReadTrack — Use Case Diagram

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 10
skinparam ranksep 40
skinparam usecase {
  BackgroundColor #F0F8FF
  BorderColor #4A90D9
  ArrowColor #4A90D9
  FontSize 12
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 12
  FontStyle bold
}

' === Actor ===
actor "Teacher" as teacher

' === System boundary ===
rectangle "ReadTrack System" {

  package "Authentication" {
    usecase "Login" as UC_LOGIN
    usecase "Logout" as UC_LOGOUT
  }

  package "Student Grading" {
    usecase "Upload Student Essay\n(Text / Image / PDF)" as UC_UPLOAD
    usecase "Classify Writing Level\n(Nagsisimula / Papaunlad / Mahusay)" as UC_PROFICIENCY
    usecase "Classify Text Complexity\n(Literal / Inferential / Evaluative)" as UC_COMPLEXITY
    usecase "Generate AI Rubric Feedback" as UC_FEEDBACK
    usecase "View & Save Grading Results" as UC_SAVE
  }

  package "Material Library" {
    usecase "Upload Reading Material\n(Text / Image / PDF)" as UC_MATERIAL
    usecase "Auto-Detect Material Language\n(English / Filipino)" as UC_LANG_DETECT
    usecase "Auto-Classify Material Complexity" as UC_MAT_CLASSIFY
    usecase "Browse & Filter Materials\n(by Language and Complexity)" as UC_BROWSE
  }

  package "Material Checker — G7 Suitability" {
    usecase "Paste or Upload Reading Material" as UC_MC_INPUT
    usecase "Analyze Complexity via SVM" as UC_MC_ANALYZE
    usecase "Derive G7 Verdict\n(DepEd MELCs — Ready / Support / Above G7)" as UC_G7_VERDICT
    usecase "View Phil-IRI Reading Level\n(Flesch-Kincaid display indicator)" as UC_PHILIRI
    usecase "View Vocabulary Breakdown\n(CEFR: Basic / Intermediate / Advanced)" as UC_VOCAB
  }

  package "Grammar & Spelling" {
    usecase "Check Grammar\n(LanguageTool rules engine)" as UC_GRAMMAR
    usecase "Check Spelling\n(SymSpellPy dictionary)" as UC_SPELLING
    usecase "AI-Enhanced Corrections\n(Gemini context-aware)" as UC_AI_GRAMMAR
  }

  package "Text Ingestion" {
    usecase "Extract Text from Image\n(Gemini Vision OCR)" as UC_OCR
    usecase "Extract Text from PDF\n(pypdf)" as UC_PDF
    usecase "Detect Language\n(English / Filipino)" as UC_LANG
  }

  package "Dashboard & Analytics" {
    usecase "View Grade 7 Complexity\nDistribution Chart" as UC_COMPLEXITY_CHART
    usecase "View Student Proficiency\nDistribution Chart" as UC_PROFICIENCY_CHART
    usecase "View Essay & Material Counts" as UC_COUNTS
    usecase "Navigate to Tools\n(Quick Actions)" as UC_QUICKNAV
  }

  package "Model Management" {
    usecase "View ML Model Performance\n(Accuracy, F1 Score)" as UC_EVAL
    usecase "Trigger Model Retraining\n(from teacher-rated samples)" as UC_RETRAIN
  }

}

' === Teacher connections ===
teacher -- UC_LOGIN
teacher -- UC_LOGOUT
teacher -- UC_UPLOAD
teacher -- UC_MATERIAL
teacher -- UC_BROWSE
teacher -- UC_MC_INPUT
teacher -- UC_GRAMMAR
teacher -- UC_COMPLEXITY_CHART
teacher -- UC_PROFICIENCY_CHART
teacher -- UC_COUNTS
teacher -- UC_QUICKNAV
teacher -- UC_EVAL
teacher -- UC_RETRAIN

' === Student Grading includes / extends ===
UC_OCR         ..> UC_UPLOAD     : <<extend>>
UC_PDF         ..> UC_UPLOAD     : <<extend>>
UC_UPLOAD ..> UC_LANG      : <<include>>
UC_UPLOAD ..> UC_PROFICIENCY : <<include>>
UC_UPLOAD ..> UC_COMPLEXITY  : <<include>>
UC_UPLOAD ..> UC_FEEDBACK    : <<include>>
UC_PROFICIENCY ..> UC_SAVE   : <<include>>

' === Material Library includes ===
UC_MATERIAL ..> UC_LANG_DETECT   : <<include>>
UC_MATERIAL ..> UC_MAT_CLASSIFY  : <<include>>

' === Material Checker includes ===
UC_MC_INPUT ..> UC_MC_ANALYZE    : <<include>>
UC_MC_ANALYZE ..> UC_G7_VERDICT  : <<include>>
UC_G7_VERDICT ..> UC_PHILIRI     : <<include>>
UC_VOCAB       ..> UC_G7_VERDICT  : <<extend>>

' === Grammar extends ===
UC_GRAMMAR ..> UC_SPELLING       : <<include>>
UC_AI_GRAMMAR  ..> UC_GRAMMAR      : <<extend>>

@enduml
